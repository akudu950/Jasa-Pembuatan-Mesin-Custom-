---
import type { Category } from '../data/site';
import { SITE_CONFIG } from '../data/site';

interface Props {
  category: Category;
  index?: number;
}

const { category, index } = Astro.props;
const displayIndex = index !== undefined ? String(index + 1).padStart(2, '0') : null;
---

<a
  href={`${SITE_CONFIG.basePath}kategori/${category.slug}/`}
  class="group flex flex-col justify-between p-6 bg-white rounded-xl border border-slate-200 hover:border-orange-500 hover:shadow-lg transition-all duration-200"
>
  <div>
    <!-- Clean human editorial numbering / kicker -->
    <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
      {displayIndex && <span class="font-mono text-slate-400">{displayIndex}</span>}
      <span class="text-orange-600 font-medium">Sektor Industri</span>
    </div>

    <h3 class="text-lg font-bold text-slate-900 group-hover:text-orange-600 transition-colors">
      {category.title}
    </h3>

    <p class="mt-2 text-sm text-slate-600 line-clamp-3 leading-relaxed">
      {category.shortDesc}
    </p>

    <!-- Key Features List (Unboxed) -->
    <div class="mt-4 pt-4 border-t border-slate-100 space-y-1.5 text-xs text-slate-500">
      {category.features.slice(0, 2).map((feat) => (
        <div class="flex items-center gap-2">
          <span class="text-orange-500 font-bold">✓</span>
          <span>{feat}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-6 flex items-center text-xs font-semibold text-orange-600 group-hover:text-orange-500">
    <span>Eksplorasi Kategori</span>
    <span class="ml-1 group-hover:translate-x-1 transition-transform">&rarr;</span>
  </div>
</a>
