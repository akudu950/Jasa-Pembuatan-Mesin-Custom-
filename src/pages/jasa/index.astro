---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTA from '../../components/CTA.astro';
import { SERVICES, SITE_CONFIG } from '../../data/site';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': `${SITE_CONFIG.siteUrl}${SITE_CONFIG.basePath}`,
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Jasa Mesin',
      'item': `${SITE_CONFIG.siteUrl}${SITE_CONFIG.basePath}jasa/`,
    },
  ],
};
---

<Layout
  title="Jasa Pembuatan & Fabrikasi Mesin Custom Industri"
  description="Katalog jasa pembuatan mesin custom: mesin filling liquid, pengemas packaging, conveyor modular, pencacah shredder, mixer, dan press hidrolik."
  schemaJson={breadcrumbSchema}
>
  <section class="bg-slate-900 text-white py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href={SITE_CONFIG.basePath} class="hover:text-white transition-colors">Home</a>
        <span aria-hidden="true">/</span>
        <span class="text-orange-400">Layanan Jasa</span>
      </nav>

      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight" style="text-wrap: balance;">
          Layanan Pembuatan Mesin Custom Industri
        </h1>
        <p class="mt-3 text-base text-slate-300 leading-relaxed">
          Temukan solusi mesin otomatisasi dan permesinan presisi yang dirancang khusus untuk meningkatkan efisiensi dan kapasitas lini produksi Anda.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {SERVICES.map((srv) => (
          <ServiceCard service={srv} />
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
