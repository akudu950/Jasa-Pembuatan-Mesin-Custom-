---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { ARTICLES, SERVICES, CATEGORIES, SITE_CONFIG, getWhatsAppUrl } from '../../data/site';

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

const relatedServicesList = SERVICES.filter((s) => article.relatedServices.includes(s.slug));
const relatedCat = CATEGORIES.find((c) => c.slug === article.relatedCategory);

const articleSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    'headline': article.title,
    'description': article.excerpt,
    'datePublished': article.publishDate,
    'author': {
      '@type': 'Person',
      'name': article.author,
    },
    'publisher': {
      '@type': 'Organization',
      'name': SITE_CONFIG.companyName,
      'logo': {
        '@type': 'ImageObject',
        'url': `${SITE_CONFIG.siteUrl}${SITE_CONFIG.basePath}favicon.svg`,
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Home',
        'item': `${SITE_CONFIG.siteUrl}${SITE_CONFIG.basePath}`,
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'Artikel',
        'item': `${SITE_CONFIG.siteUrl}${SITE_CONFIG.basePath}artikel/`,
      },
      {
        '@type': 'ListItem',
        'position': 3,
        'name': article.title,
        'item': `${SITE_CONFIG.siteUrl}${SITE_CONFIG.basePath}artikel/${article.slug}/`,
      },
    ],
  },
  ...(article.content.faqs.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          'mainEntity': article.content.faqs.map((faq) => ({
            '@type': 'Question',
            'name': faq.question,
            'acceptedAnswer': {
              '@type': 'Answer',
              'text': faq.answer,
            },
          })),
        },
      ]
    : []),
];
---

<Layout
  title={article.seoTitle}
  description={article.seoDescription}
  schemaJson={articleSchema}
>
  <article class="bg-white">
    <!-- Header -->
    <header class="bg-slate-900 text-white py-16 border-b border-slate-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6" aria-label="Breadcrumb">
          <a href={SITE_CONFIG.basePath} class="hover:text-white transition-colors">Home</a>
          <span aria-hidden="true">/</span>
          <a href={`${SITE_CONFIG.basePath}artikel/`} class="hover:text-white transition-colors">Artikel</a>
          <span aria-hidden="true">/</span>
          <span class="text-orange-400">{article.category}</span>
        </nav>

        <div class="flex items-center gap-2 text-xs text-slate-400 mb-3">
          <span class="text-orange-400 font-semibold">{article.category}</span>
          <span aria-hidden="true">·</span>
          <span>{article.publishDate}</span>
          <span aria-hidden="true">·</span>
          <span>{article.readTime}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight" style="text-wrap: balance;">
          {article.title}
        </h1>

        <p class="mt-4 text-xs text-slate-400">
          Ditulis oleh <strong class="text-slate-200">{article.author}</strong>
        </p>
      </div>
    </header>

    <!-- Main Editorial Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      
      <!-- Lead Intro -->
      <div class="text-lg text-slate-700 leading-relaxed font-medium pb-8 border-b border-slate-100">
        <p>{article.content.intro}</p>
      </div>

      <!-- Content Sections -->
      <div class="py-8 space-y-12">
        {article.content.sections.map((sec) => (
          <section class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
              {sec.heading}
            </h2>

            {sec.subheading && (
              <h3 class="text-base font-semibold text-slate-800">
                {sec.subheading}
              </h3>
            )}

            {sec.body.map((para) => (
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
                {para}
              </p>
            ))}

            {sec.bullets && (
              <ul class="my-4 space-y-2 text-sm text-slate-600 bg-slate-50 p-5 rounded-xl border border-slate-200">
                {sec.bullets.map((b) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-orange-600 font-bold shrink-0">✦</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>

      <!-- FAQ Section if available -->
      {article.content.faqs.length > 0 && (
        <section class="mt-12 pt-12 border-t border-slate-200">
          <h2 class="text-2xl font-bold text-slate-900 mb-6">Pertanyaan Sering Diajukan (FAQ)</h2>
          <div class="space-y-4">
            {article.content.faqs.map((faq) => (
              <div class="p-6 bg-slate-50 rounded-xl border border-slate-200">
                <h3 class="text-base font-bold text-slate-900 mb-2">{faq.question}</h3>
                <p class="text-sm text-slate-600 leading-relaxed">{faq.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Internal Linking Box (Related Services & Categories) -->
      <section class="mt-16 pt-10 border-t border-slate-200 bg-slate-50 p-6 rounded-2xl">
        <h3 class="text-base font-bold text-slate-900 mb-4">Layanan &amp; Sektor Terkait Artikel Ini</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedServicesList.map((srv) => (
            <a
              href={`${SITE_CONFIG.basePath}jasa/${srv.slug}/`}
              class="p-4 bg-white rounded-lg border border-slate-200 hover:border-orange-500 transition-colors"
            >
              <span class="text-xs text-orange-600 font-semibold block">Layanan Jasa</span>
              <span class="text-sm font-bold text-slate-800">{srv.title}</span>
              <p class="text-xs text-slate-500 mt-1 line-clamp-1">{srv.shortDesc}</p>
            </a>
          ))}

          {relatedCat && (
            <a
              href={`${SITE_CONFIG.basePath}kategori/${relatedCat.slug}/`}
              class="p-4 bg-white rounded-lg border border-slate-200 hover:border-orange-500 transition-colors"
            >
              <span class="text-xs text-orange-600 font-semibold block">Kategori Industri</span>
              <span class="text-sm font-bold text-slate-800">{relatedCat.title}</span>
              <p class="text-xs text-slate-500 mt-1 line-clamp-1">{relatedCat.shortDesc}</p>
            </a>
          )}
        </div>
      </section>

    </div>
  </article>

  <CTA
    title="Ingin Mewujudkan Mesin Custom Berkualitas?"
    description="Hubungi tim engineering kami untuk konsultasi teknis dan estimasi perancangan mesin industri Anda."
    customMessage={`Halo, saya baru membaca artikel '${article.title}' dan ingin konsultasi mesin.`}
  />
</Layout>
