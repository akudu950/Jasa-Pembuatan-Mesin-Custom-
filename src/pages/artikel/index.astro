---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CTA from '../../components/CTA.astro';
import { ARTICLES, SITE_CONFIG } from '../../data/site';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': `${SITE_CONFIG.siteUrl}${SITE_CONFIG.basePath}`,
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Artikel',
      'item': `${SITE_CONFIG.siteUrl}${SITE_CONFIG.basePath}artikel/`,
    },
  ],
};
---

<Layout
  title="Portal Artikel Mesin Custom & Rekayasa Manufaktur"
  description="Kumpulan panduan teknis, tips pengadaan mesin industri, estimasi biaya fabrikasi, dan wawasan otomatisasi pabrik di Indonesia."
  schemaJson={breadcrumbSchema}
>
  <section class="bg-slate-900 text-white py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href={SITE_CONFIG.basePath} class="hover:text-white transition-colors">Home</a>
        <span aria-hidden="true">/</span>
        <span class="text-orange-400">Artikel &amp; Panduan</span>
      </nav>

      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight" style="text-wrap: balance;">
          Pusat Wawasan &amp; Panduan Mesin Custom
        </h1>
        <p class="mt-3 text-base text-slate-300 leading-relaxed">
          Artikel terpercaya seputar pemilihan vendor fabrikasi, kalkulasi biaya investasi mesin, perancangan mekatronika, dan optimasi lini manufaktur modern.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {ARTICLES.map((art) => (
          <ArticleCard article={art} />
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
