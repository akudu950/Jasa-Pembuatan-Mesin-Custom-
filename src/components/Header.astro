---
import { SITE_CONFIG, getWhatsAppUrl } from '../data/site';

const navLinks = [
  { name: 'Home', href: `${SITE_CONFIG.basePath}` },
  { name: 'Jasa', href: `${SITE_CONFIG.basePath}jasa/` },
  { name: 'Kategori Mesin', href: `${SITE_CONFIG.basePath}kategori/` },
  { name: 'Proyek', href: `${SITE_CONFIG.basePath}proyek/` },
  { name: 'Artikel', href: `${SITE_CONFIG.basePath}artikel/` },
  { name: 'Kontak', href: `${SITE_CONFIG.basePath}kontak/` },
];

const waLink = getWhatsAppUrl('Halo, saya ingin konsultasi mengenai jasa pembuatan mesin custom.');
---

<header class="sticky top-0 z-40 w-full bg-slate-900/95 backdrop-blur-md border-b border-slate-800 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Zone 1: Brand Wordmark -->
      <a href={SITE_CONFIG.basePath} class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-lg bg-orange-600 flex items-center justify-center text-white font-bold text-xl shadow-md group-hover:bg-orange-500 transition-colors">
          M
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-bold tracking-tight text-white group-hover:text-orange-400 transition-colors whitespace-nowrap">
            {SITE_CONFIG.name}
          </span>
          <span class="text-[11px] text-slate-400 tracking-wider uppercase font-medium">
            Industrial Engineering &amp; Fabrication
          </span>
        </div>
      </a>

      <!-- Zone 2: Navigation Links -->
      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-300">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="hover:text-white transition-colors relative py-1 hover:border-b-2 hover:border-orange-500 whitespace-nowrap"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Zone 3: Primary Action & Mobile Menu Toggle -->
      <div class="flex items-center gap-4">
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white bg-orange-600 rounded-lg hover:bg-orange-500 transition-colors shadow-sm whitespace-nowrap"
        >
          Konsultasi Sekarang
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-orange-500"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Buka menu navigasi"
        >
          <svg class="h-6 w-6 block" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="h-6 w-6 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="hidden md:hidden border-t border-slate-800 bg-slate-900 px-4 pt-3 pb-6 space-y-2" id="mobile-menu">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2 rounded-md text-base font-medium text-slate-200 hover:text-white hover:bg-slate-800 transition-colors"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-4 mt-2 border-t border-slate-800">
      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center px-4 py-3 rounded-lg text-sm font-semibold uppercase tracking-wider text-white bg-orange-600 hover:bg-orange-500 transition-colors"
      >
        Konsultasi via WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (btn && menu && openIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
