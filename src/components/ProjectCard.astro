---
import type { Project } from '../data/site';
import { SITE_CONFIG } from '../data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="flex flex-col bg-white rounded-xl border border-slate-200 overflow-hidden hover:border-slate-300 hover:shadow-lg transition-all duration-200">
  <div class="relative aspect-[16/10] bg-slate-900 overflow-hidden">
    <img
      src={`${SITE_CONFIG.basePath}${project.image.replace(/^\//, '')}`}
      alt={project.title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
      referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
    <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs text-slate-300">
      <span class="font-medium text-white">{project.industry}</span>
      <span class="text-slate-400">Tahun {project.completionYear}</span>
    </div>
  </div>

  <div class="p-6 flex-grow flex flex-col justify-between">
    <div>
      <h3 class="text-lg font-bold text-slate-900 hover:text-orange-600 transition-colors">
        <a href={`${SITE_CONFIG.basePath}proyek/${project.slug}/`}>
          {project.title}
        </a>
      </h3>

      <p class="mt-2 text-sm text-slate-600 line-clamp-2 leading-relaxed">
        {project.summary}
      </p>

      <!-- Key Result Highlight -->
      <div class="mt-4 p-3 bg-slate-50 border border-slate-100 rounded-lg text-xs text-slate-700 space-y-1">
        <span class="font-semibold text-orange-600 block">Hasil Utama:</span>
        <p class="text-slate-600">{project.results[0]}</p>
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
      <a
        href={`${SITE_CONFIG.basePath}proyek/${project.slug}/`}
        class="text-xs font-semibold text-slate-900 hover:text-orange-600 transition-colors inline-flex items-center gap-1"
      >
        Lihat Studi Kasus &rarr;
      </a>
      <span class="text-xs text-slate-400">{project.clientType}</span>
    </div>
  </div>
</div>
