---
import type { Service } from '../data/site';
import { SITE_CONFIG, getWhatsAppUrl } from '../data/site';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const waLink = getWhatsAppUrl(`Halo, saya ingin konsultasi mengenai ${service.title}.`);
---

<div class="flex flex-col bg-white rounded-xl border border-slate-200 overflow-hidden hover:border-slate-300 hover:shadow-md transition-all duration-200">
  <!-- Service Image Container -->
  <div class="relative aspect-[16/10] bg-slate-900 overflow-hidden">
    <img
      src={`${SITE_CONFIG.basePath}${service.image.replace(/^\//, '')}`}
      alt={`Spesialis pembuatan ${service.title}`}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
      referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
    <div class="absolute bottom-3 left-4 text-xs font-medium text-slate-300">
      {service.categoryTitle}
    </div>
  </div>

  <!-- Body -->
  <div class="p-6 flex-grow flex flex-col justify-between">
    <div>
      <h3 class="text-lg font-bold text-slate-900 hover:text-orange-600 transition-colors">
        <a href={`${SITE_CONFIG.basePath}jasa/${service.slug}/`}>
          {service.title}
        </a>
      </h3>

      <p class="mt-2 text-sm text-slate-600 line-clamp-2 leading-relaxed">
        {service.shortDesc}
      </p>

      <!-- Key Specs (Clean unboxed tabular pairs) -->
      <div class="mt-4 pt-3 border-t border-slate-100 space-y-1 text-xs">
        {service.specs.slice(0, 2).map((sp) => (
          <div class="flex justify-between items-baseline gap-2 text-slate-600">
            <span class="text-slate-400">{sp.label}:</span>
            <span class="font-medium text-slate-800 text-right">{sp.value}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Actions -->
    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
      <a
        href={`${SITE_CONFIG.basePath}jasa/${service.slug}/`}
        class="text-xs font-semibold text-slate-900 hover:text-orange-600 transition-colors inline-flex items-center gap-1"
      >
        Detail Spesifikasi &rarr;
      </a>
      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 text-xs font-semibold text-white bg-slate-900 hover:bg-orange-600 rounded transition-colors whitespace-nowrap"
      >
        Tanya Mesin Ini
      </a>
    </div>
  </div>
</div>
