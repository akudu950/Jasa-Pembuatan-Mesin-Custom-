---
import Layout from '../../layouts/Layout.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import CTA from '../../components/CTA.astro';
import { CATEGORIES, SITE_CONFIG } from '../../data/site';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': `${SITE_CONFIG.siteUrl}${SITE_CONFIG.basePath}`,
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Kategori Mesin',
      'item': `${SITE_CONFIG.siteUrl}${SITE_CONFIG.basePath}kategori/`,
    },
  ],
};
---

<Layout
  title="Kategori Mesin Custom Industri - Fabrikasi Sesuai Sektor"
  description="Daftar lengkap kategori mesin custom: F&B, manufaktur logam, pertanian, pengolahan limbah, packaging, dan material handling conveyor."
  schemaJson={breadcrumbSchema}
>
  <section class="bg-slate-900 text-white py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href={SITE_CONFIG.basePath} class="hover:text-white transition-colors">Home</a>
        <span aria-hidden="true">/</span>
        <span class="text-orange-400">Kategori Mesin</span>
      </nav>

      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight" style="text-wrap: balance;">
          Kategori Mesin Custom Berdasarkan Sektor Industri
        </h1>
        <p class="mt-3 text-base text-slate-300 leading-relaxed">
          Setiap sektor memiliki karakteristik bahan baku, standar higienitas, dan tuntutan beban yang berbeda. Pilih kategori untuk melihat kapabilitas rekayasa kami.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {CATEGORIES.map((cat, idx) => (
          <CategoryCard category={cat} index={idx} />
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
