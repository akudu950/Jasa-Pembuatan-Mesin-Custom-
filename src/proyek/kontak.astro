---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import { SITE_CONFIG, getWhatsAppUrl } from '../data/site';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  'name': `Hubungi ${SITE_CONFIG.name}`,
  'description': 'Hubungi tim engineering kami untuk konsultasi spesifikasi mesin custom, penawaran harga, dan survei lokasi pabrik.',
  'mainEntity': {
    '@type': 'Organization',
    'name': SITE_CONFIG.companyName,
    'telephone': SITE_CONFIG.formattedPhone,
    'email': SITE_CONFIG.email,
    'address': {
      '@type': 'PostalAddress',
      'streetAddress': SITE_CONFIG.address,
      'addressCountry': 'ID',
    },
  },
};

const waDefault = getWhatsAppUrl('Halo, saya ingin konsultasi kebutuhan mesin custom.');
---

<Layout
  title="Hubungi Kami - Konsultasi Jasa Pembuatan Mesin Custom"
  description="Hubungi tim engineer kami untuk konsultasi spesifikasi mesin, estimasi biaya fabrikasi, dan penjadwalan survei lokasi pabrik Anda."
  schemaJson={contactSchema}
>
  <!-- Page Header -->
  <section class="bg-slate-900 text-white py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href={SITE_CONFIG.basePath} class="hover:text-white transition-colors">Home</a>
        <span aria-hidden="true">/</span>
        <span class="text-orange-400">Kontak</span>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white" style="text-wrap: balance;">
        Konsultasi Kebutuhan Mesin Custom
      </h1>
      <p class="mt-3 text-base text-slate-300 max-w-2xl leading-relaxed">
        Sampaikan rencana lini produksi, kapasitas target per jam, atau kendala operasional Anda saat ini. Tim mekanikal kami siap membantu merumuskan solusi teknis yang tepat sasaran.
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: Contact Details & Info -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-orange-600 block mb-1">
              Komunikasi Cepat
            </span>
            <h2 class="text-xl font-bold text-slate-900">Saluran Komunikasi Langsung</h2>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed">
              Kami menyarankan konsultasi awal melalui WhatsApp agar Anda dapat langsung mengirimkan foto produk, sampel kemasan, atau video alur produksi yang ada.
            </p>
          </div>

          <div class="space-y-4">
            <!-- WhatsApp Box -->
            <a
              href={waDefault}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-4 p-5 bg-emerald-50 border border-emerald-200 rounded-xl hover:bg-emerald-100/70 transition-colors group"
            >
              <div class="w-10 h-10 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold shrink-0">
                WA
              </div>
              <div>
                <span class="text-xs font-semibold text-emerald-800 uppercase tracking-wide block">WhatsApp Engineering</span>
                <span class="text-base font-bold text-slate-900 group-hover:text-emerald-700">{SITE_CONFIG.formattedPhone}</span>
                <p class="text-xs text-emerald-700 mt-1">Respons rata-rata dalam 15 menit pada jam kerja.</p>
              </div>
            </a>

            <!-- Email Box -->
            <div class="flex items-start gap-4 p-5 bg-slate-50 border border-slate-200 rounded-xl">
              <div class="w-10 h-10 rounded-lg bg-slate-800 text-white flex items-center justify-center font-bold shrink-0 text-xs">
                MAIL
              </div>
              <div>
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide block">Email Resmi</span>
                <a href={`mailto:${SITE_CONFIG.email}`} class="text-sm font-bold text-slate-900 hover:text-orange-600">
                  {SITE_CONFIG.email}
                </a>
                <p class="text-xs text-slate-500 mt-1">Untuk pengiriman dokumen tender, RFQ, atau NDA resmi.</p>
              </div>
            </div>

            <!-- Address Box -->
            <div class="flex items-start gap-4 p-5 bg-slate-50 border border-slate-200 rounded-xl">
              <div class="w-10 h-10 rounded-lg bg-slate-800 text-white flex items-center justify-center font-bold shrink-0 text-xs">
                LOC
              </div>
              <div class="text-xs text-slate-600 space-y-1">
                <span class="font-semibold text-slate-900 block text-sm">Workshop &amp; Kantor Pusat</span>
                <p class="font-medium text-slate-800">{SITE_CONFIG.companyName}</p>
                <p>{SITE_CONFIG.address}</p>
                <p class="text-slate-500 pt-1">Jam Layanan: {SITE_CONFIG.operatingHours}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Inquiry Form with Auto WhatsApp Generator -->
        <div class="lg:col-span-7 bg-slate-50 p-8 rounded-2xl border border-slate-200">
          <span class="text-xs font-semibold uppercase tracking-wider text-orange-600 block mb-1">
            Formulir Spesifikasi Mesin
          </span>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Deskripsikan Rencana Mesin Anda</h2>
          <p class="text-xs text-slate-600 mb-6 leading-relaxed">
            Isi rincian di bawah ini untuk menghasilkan pesan konsultasi terstruktur yang langsung terhubung ke tim engineer kami via WhatsApp.
          </p>

          <form id="inquiry-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="client-name" class="block text-xs font-medium text-slate-700 mb-1">Nama Lengkap / PIC *</label>
                <input
                  type="text"
                  id="client-name"
                  required
                  placeholder="Contoh: Budi Santoso"
                  class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-orange-500"
                />
              </div>

              <div>
                <label for="company-name" class="block text-xs font-medium text-slate-700 mb-1">Nama Perusahaan / Usaha *</label>
                <input
                  type="text"
                  id="company-name"
                  required
                  placeholder="Contoh: PT Sumber Pangan Utama"
                  class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-orange-500"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="machine-type" class="block text-xs font-medium text-slate-700 mb-1">Jenis Mesin yang Dibutuhkan *</label>
                <select
                  id="machine-type"
                  class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-orange-500"
                >
                  <option value="Mesin Filling Cairan / Pasta">Mesin Filling Cairan / Pasta</option>
                  <option value="Mesin Pengemas Packaging">Mesin Pengemas Packaging</option>
                  <option value="Sistem Conveyor Modular">Sistem Conveyor Modular</option>
                  <option value="Mesin Pencacah Shredder">Mesin Pencacah Shredder</option>
                  <option value="Mesin Mixer / Blender Industri">Mesin Mixer / Blender Industri</option>
                  <option value="Mesin Press Hidrolik">Mesin Press Hidrolik</option>
                  <option value="Mesin Khusus SPM Lainnya">Mesin Khusus SPM Lainnya</option>
                </select>
              </div>

              <div>
                <label for="target-capacity" class="block text-xs font-medium text-slate-700 mb-1">Target Kapasitas / Jam</label>
                <input
                  type="text"
                  id="target-capacity"
                  placeholder="Contoh: 1.000 botol/jam atau 500 kg/jam"
                  class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-orange-500"
                />
              </div>
            </div>

            <div>
              <label for="project-details" class="block text-xs font-medium text-slate-700 mb-1">Detail Kebutuhan &amp; Spesifikasi Produk *</label>
              <textarea
                id="project-details"
                rows="4"
                required
                placeholder="Jelaskan jenis bahan yang diproses, ukuran wadah/kemasan, tingkat otomatisasi yang diinginkan, dan dimensi ruangan pabrik bila ada."
                class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-orange-500"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3.5 px-6 text-sm font-semibold uppercase tracking-wider text-white bg-orange-600 hover:bg-orange-500 rounded-lg transition-colors shadow-md whitespace-nowrap"
            >
              Kirim via WhatsApp ke Engineer
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <CTA />

  <script>
    const form = document.getElementById('inquiry-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = (document.getElementById('client-name') as HTMLInputElement)?.value || '';
        const company = (document.getElementById('company-name') as HTMLInputElement)?.value || '';
        const machine = (document.getElementById('machine-type') as HTMLSelectElement)?.value || '';
        const capacity = (document.getElementById('target-capacity') as HTMLInputElement)?.value || '-';
        const details = (document.getElementById('project-details') as HTMLTextAreaElement)?.value || '';

        const msg = `Halo Tim Engineer Jasa Pembuatan Mesin Custom,\n\nNama: ${name}\nPerusahaan: ${company}\nKebutuhan Mesin: ${machine}\nTarget Kapasitas: ${capacity}\n\nRincian Kebutuhan:\n${details}\n\nMohon info estimasi konsep dan jadwal konsultasi teknis. Terima kasih.`;
        const url = `https://wa.me/6281234567890?text=${encodeURIComponent(msg)}`;
        window.open(url, '_blank');
      });
    }
  </script>
</Layout>
